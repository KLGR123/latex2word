# Paste your API key for the provider you want to use.
# Only the key for the provider you select needs to be filled in.
#
# Copy this file to secrets.env and add your key:
#   cp secrets.env.example secrets.env
#
# Provider         | --provider value | Variable name below
# -----------------|------------------|--------------------
# Anthropic Claude | anthropic        | ANTHROPIC_API_KEY
# OpenAI           | openai           | OPENAI_API_KEY
# DeepSeek         | deepseek         | DEEPSEEK_API_KEY
# Moonshot (Kimi)  | kimi             | MOONSHOT_API_KEY

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
